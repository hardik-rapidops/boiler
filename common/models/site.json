{
    "name": "Site",
    "replaceOnPUT": false,
    "description": "Manages Site info and related data.",
    "base": "PersistedModel",
    "strict": false,
    "idInjection": true,
    "forceId": false,
    "options": {
        "validateUpsert": true
    },
    "properties": {
        "id": {
            "type": "string",
            "id": true,
            "required": true,
            "defaultFn": "uuidv4"
        },
        "address": {
            "type": "string"
        },
        "city": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "name": {
            "type": "string",
            "required": true
        },
        "state": {
            "type": "string"
        },
        "zip": {
            "type": "string",
            "required": true
        },
        "disableNotification": {
            "type": "boolean"
        }
    },
    "validations": [],
    "relations": {
        "boilers": {
            "type": "hasMany",
            "model": "Boiler",
            "foreignKey": ""
        },
        "users": {
            "type": "hasMany",
            "model": "user",
            "through": "UserToSite"
        },
        "site": {
            "type": "belongsTo",
            "model": "user",
            "foreignKey": ""
        }
    },
    "acls": [
        {
            "accessType": "*",
            "principalType": "ROLE",
            "principalId": "$everyone",
            "permission": "DENY"
        },
        {
            "accessType": "READ",
            "principalType": "ROLE",
            "principalId": "$authenticated",
            "permission": "ALLOW"
        },
        {
            "principalType": "ROLE",
            "principalId": "$everyone",
            "permission": "DENY",
            "property": "deleteById"
        },
        {
            "accessType": "EXECUTE",
            "principalType": "ROLE",
            "principalId": "$authenticated",
            "permission": "ALLOW",
            "property": "create"
        },
        {
            "accessType": "EXECUTE",
            "principalType": "ROLE",
            "principalId": "$authenticated",
            "permission": "ALLOW",
            "property": "find"
        },
        {
            "accessType": "EXECUTE",
            "principalType": "ROLE",
            "principalId": "pkAdmin",
            "permission": "ALLOW",
            "property": "find"
        },
        {
            "principalType": "ROLE",
            "principalId": "$owner",
            "permission": "ALLOW",
            "property": "deleteById"
        },
        {
            "accessType": "EXECUTE",
            "principalType": "ROLE",
