{
  "name": "Boiler",
  "replaceOnPUT": false,
  "description": "Manages Boiler info and related data.",
  "base": "PersistedModel",
  "strict": false,
  "idInjection": true,
  "forceId": false,
  "options": {
    "validateUpsert": true
  },
  "hidden": [
    "signature",
    "newBoilerDate",
    "codeGeneratedDate"
  ],
  "properties": {
    "id": {
      "type": "string",
      "id": true,
      "index": true,
      "required": true,
      "defaultFn": "uuidv4"
    },
    "description": {
      "type": "string",
      "nullable": true,
      "dataLength": 20
    },
    "nuroSN": {
      "type": "string",
      "required": true
    },
    "solaSN": {
      "type": "string",
      "required": true
    },
    "model": {
      "type": "string"
    },
    "alertsDisabled": {
      "type": "boolean",
      "default": true
    },
    "relayEnergizedAlert": {
      "type": "boolean",
      "default": false
    },
    "holdErrorAlert": {
      "type": "boolean",
      "default": false
    },
    "lockoutErrorAlert": {
      "type": "boolean",
      "default": false
    },
    "alertInterval": {
      "type": "number",
      "default": 0
    },
    "name": {
      "type": "string",
      "required": true
    },
    "isPaid": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "tempAlerts": {
      "type": [
        "BoilerAlertTemp"
      ]
    }
  },
  "mixins": {
    "SoftDelete" : true
  },
  "validations": [],
  "relations": {
    "site": {
      "type": "belongsTo",
      "model": "Site",
      "foreignKey": ""
    },
    "notifications": {
      "type": "hasMany",
      "model": "Notification",
      "foreignKey": ""
    },
    "boilerRecords": {
      "type": "hasMany",
      "model": "BoilerReadRecord",
      "foreignKey": ""
    }
  },
  "acls": [
      {
        "accessType": "*",
        "principalType": "ROLE",
        "principalId": "$everyone",
        "permission": "DENY"
      },
      {
        "accessType": "READ",
        "principalType": "ROLE",
        "principalId": "$authenticated",
        "permission": "ALLOW"
      },
      {
          "principalType": "ROLE",
          "principalId": "$everyone",
          "permission": "ALLOW",
          "property": "newBoiler"
      },
      {
          "principalType": "ROLE",
          "principalId": "$authenticated",
          "permission": "ALLOW",
          "property": "replaceOrCreate"
      },
      {
          "principalType": "ROLE",
          "principalId": "$authenticated",
          "permission": "ALLOW",
          "property": "upsertWithWhere"
      }

  ],
  "methods": {}
}
