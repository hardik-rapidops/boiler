{
    "name": "user",
    "replaceOnPUT": false,
    "description": "Manages User info and related data.",
    "base": "User",
    "strict": false,
    "idInjection": false,
    "options": {
        "validateUpsert": true
    },
    
    "properties": {
        "company": {
            "type": "string"
