        },
        "lastName": {
            "type": "string"
        },
        "title": {
            "type": "string"
        },
        "emailNotifications": {
            "type":"boolean",
            "default":true
        },
        "passwordKey":{
        "type": "string"
        }
    },
    
    "hidden": ["passwordKey"],
    "validations": [],
