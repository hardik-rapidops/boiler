            "model": "Role",
            "through": "RoleMapping",
            "foreignKey": "principalId"
        },
        "sites": {
            "type": "hasMany",
            "model": "Site",
            "foreignKey": "userId",
            "through": "UserToSite"
        },
        "devices": {
            "type": "hasMany",
            "model": "Device",
            "foreignKey": ""
        }
    },
